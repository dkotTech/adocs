# Quote values that contain spaces or special characters,
# otherwise parsing stops at that line and the server will not start.

# Mounted directory: a docker-compose volume, a Kubernetes persistent volume, S3 via a driver.
ADOCS_DATA_DIR=/data
# Archive file name inside that directory: tar, tar.gz or zip.
ADOCS_ARCHIVE=repo.tar.gz

# Local cache: the archive copy and the extracted documents. Defaults to a temporary directory.
# ADOCS_CACHE_DIR=/tmp/adocs

# Size limit for the archive and its unpacked contents, a guard against archive bombs.
ADOCS_MAX_SIZE_MB=1024

APP_HOST=127.0.0.1
APP_PORT=8080

# Allow regular expressions in the public search API (true/false).
# Matching is linear-time, but a heavy pattern still scans every file; off by default.
ADOCS_SEARCH_REGEX=false

# Public address for absolute links in llms.txt and sitemap.xml.
# Without it the address is taken from the request Host header. Set it in production.
# APP_BASE_URL=https://docs.example.com

# Host names to answer to, comma-separated; others get 421. Guards against DNS rebinding
# when access is restricted from the outside. Empty turns the check off.
# APP_ALLOWED_HOSTS=docs.example.com,adocs.docs.svc

# Take that address from Forwarded and X-Forwarded-* headers (true/false).
# Only behind a proxy that sets them, or a forged header can end up in a proxy cache.
APP_TRUST_FORWARDED=false

# Title in the header and in llms.txt.
SITE_TITLE=adocs

RUST_LOG=info

# OAuth client of the organization for "Drive" on a document: the employee signs in to Google
# themselves and the file is created in their own Drive. A public identifier, not a secret.
# Empty leaves the button out and the page then asks accounts.google.com for nothing.
# Google Cloud console: consent screen "Internal", scope drive.file, client type "Web application",
# the portal address in the authorized JavaScript origins.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Limits for reading tables (csv, tsv, xlsx, xls, xlsb, ods). A table is read whole into memory and
# then handed to the browser, so these are ceilings, not targets. A file above the size limit is not
# opened at all and stays a download.
# ADOCS_SHEET_MAX_MB=64
# ADOCS_SHEET_MAX_ROWS=20000
# ADOCS_SHEET_MAX_COLS=512
# Cells in one sheet: rows and columns multiply, so this is what bounds the memory and the size of
# the answer. On a 41-column table 200 000 cells are about 2.4 MB of JSON.
# ADOCS_SHEET_MAX_CELLS=200000
# ADOCS_SHEET_MAX_SHEETS=64
# ADOCS_SHEET_MAX_CELL_CHARS=2000
# Column names listed in the one-line summary in llms.txt.
# ADOCS_SHEET_SUMMARY_COLUMNS=24
